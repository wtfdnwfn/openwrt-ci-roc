# ================= 系统基础 =================
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# ================= LuCI 基础环境 (必选，否则无Web界面) =================
CONFIG_PACKAGE_luci-light=y          # 使用轻量级 LuCI 核心
CONFIG_PACKAGE_uhttpd=y              # Web 服务器
CONFIG_PACKAGE_rpcd=y                # LuCI 后端服务
CONFIG_PACKAGE_rpcd-mod-luci=y       # LuCI 必备RPC模块，避免功能异常
CONFIG_PACKAGE_luci-theme-bootstrap=y # 原生轻量主题，无额外体积
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y # 简体中文语言包
CONFIG_PACKAGE_luci-app-diskman=y    # 磁盘管理插件，查看USB存储状态

# ================= 文件系统与存储 =================
CONFIG_PACKAGE_kmod-fs-f2fs=y        # F2FS 文件系统完整支持
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_zram-swap=y           # Zram 内存交换，提升小内存设备性能
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_PACKAGE_block-mount=y         # 挂载管理基础依赖
CONFIG_PACKAGE_fdisk=y               # 分区工具
CONFIG_PACKAGE_lsblk=y               # 块设备列表工具
CONFIG_PACKAGE_zoneinfo-asia=y       # 亚洲时区支持，LuCI时间自动同步

# ================= 打印与共享服务 =================
CONFIG_PACKAGE_kmod-usb-core=y       # USB 核心驱动
CONFIG_PACKAGE_kmod-usb3=y           # USB 3.0 驱动
CONFIG_PACKAGE_kmod-usb-storage=y    # USB 存储驱动
CONFIG_PACKAGE_kmod-usb-printer=y    # USB 打印驱动
CONFIG_PACKAGE_p910nd=y              # 轻量打印服务器，完美适配HP1020Plus
CONFIG_PACKAGE_samba4-server-mini=y  # 无perl轻量Samba，大幅缩减体积
CONFIG_PACKAGE_luci-app-samba4=n     # 移除Samba的LuCI配置界面，手动配置更精简

# ================= 网络工具 =================
CONFIG_PACKAGE_etherwake=y           # 命令行Wake-on-LAN，无Web界面
CONFIG_PACKAGE_openssh-sftp-server=y # SFTP文件传输支持
CONFIG_PACKAGE_vi-full=y             # Vi编辑器，替代nano
CONFIG_PACKAGE_nano=n
CONFIG_PACKAGE_nano-full=n
CONFIG_PACKAGE_opkg=n                # 彻底禁用OPKG在线安装
CONFIG_PACKAGE_apk=n                 # 彻底禁用APK包管理器

# ================= Docker (编译但不自启) =================
CONFIG_PACKAGE_dockerd=y             # 仅打包Docker守护进程，默认不启动

# ================= 彻底禁用的冗余组件 =================
CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-theme-aurora=n
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-app-aurora-config=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_tmux=n
CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_btop=n
CONFIG_PACKAGE_autocore=n
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-usb-printer=n
